<%- include("../layout/header.ejs") %>

<div class="container-fluid mt-3" dir="rtl">
    <% if (query && query.success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= query.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (query && query.errorU) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>خطأ في التعديل:</strong> <%= query.errorU %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <h3 class="fw-bold text-dark m-0">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> إدارة الكتب
        </h3>
        <button class="btn btn-primary rounded-pill shadow-sm fw-bold w-md-auto" data-bs-toggle="modal" data-bs-target="#addBookModal">
            <i class="bi bi-plus-circle-fill me-1"></i> إضافة كتاب
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <form action="/admin/books" method="GET" class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-dark"><i class="bi bi-search me-1"></i> ابحث عن كتاب</label>
                    <input type="text" name="search" class="form-control rounded-pill bg-light border-0 px-3" placeholder="عنوان الكتاب..." value="<%= query.search || '' %>">
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-bold text-dark"><i class="bi bi-tag me-1"></i> التصنيف</label>
                    <select name="category" class="form-select rounded-pill bg-light border-0">
                        <option value="">كل التصنيفات</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-bold text-dark"><i class="bi bi-person me-1"></i> المؤلف</label>
                    <select name="author" class="form-select rounded-pill bg-light border-0">
                        <option value="">كل المؤلفين</option>
                        <% authors.forEach(author => { %>
                            <option value="<%= author._id %>" <%= query.author === author._id.toString() ? 'selected' : '' %>>
                                <%= author.firstName %> <%= author.lastName %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-dark"><i class="bi bi-currency-dollar me-1"></i> السعر (من - إلى)</label>
                    <div class="input-group">
                        <input type="number" name="minPrice" value="<%= query.minPrice || '' %>" class="form-control rounded-end-pill bg-light border-0" placeholder="أقل">
                        <span class="input-group-text bg-light border-0 text-muted px-1">-</span>
                        <input type="number" name="maxPrice" value="<%= query.maxPrice || '' %>" class="form-control rounded-start-pill bg-light border-0" placeholder="أكثر">
                    </div>
                </div>
                <div class="col-lg-2 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill flex-grow-1 fw-bold shadow-sm">تطبيق</button>
                    <a href="/admin/books" class="btn btn-outline-light text-dark rounded-pill border shadow-sm px-3" title="إعادة ضبط">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-end text-nowrap">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="py-3 px-4 border-0">الغلاف</th>
                        <th class="py-3 border-0">الكتاب والمؤلف</th>
                        <th class="py-3 border-0">التصنيف</th>
                        <th class="py-3 border-0">السعر</th>
                        <th class="py-3 text-center border-0">العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (books.length > 0) { %>
                        <% books.forEach(book => { %>
                            <tr>
                                <td class="px-4 py-3">
                                    <img src="/images/<%= book.cover %>" class="rounded-3 shadow-sm border" style="width: 45px; height: 65px; object-fit: cover;">
                                </td>
                                <td>
                                    <div class="fw-bold text-dark"><%= book.title %></div>
                                    <div class="small text-primary">
                                        <i class="bi bi-person-fill me-1"></i>
                                        <%= book.author ? (book.author.firstName + ' ' + book.author.lastName) : 'مؤلف غير معروف' %>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3"><%= book.category %></span>
                                </td>
                                <td class="fw-bold text-success font-monospace">$<%= book.price %></td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="collapse" data-bs-target="#editRow<%= book._id %>">
                                            <i class="bi bi-pencil-square"></i> <span class="d-none d-sm-inline ms-1">تعديل</span>
                                        </button>
                                        <form action="/admin/books/delete/<%= book._id %>" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" onclick="return confirm('حذف الكتاب؟')">
                                                <i class="bi bi-trash3"></i> <span class="d-none d-sm-inline ms-1">حذف</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            
                            <tr class="collapse" id="editRow<%= book._id %>">
                                <td colspan="5" class="p-0 border-bottom shadow-inner">
                                    <div class="bg-light p-3 p-md-4 border-top">
                                        <form action="/admin/books/update/<%= book._id %>" method="POST" enctype="multipart/form-data" class="row g-3">
                                            <div class="col-12 col-md-3">
                                                <label class="small fw-bold mb-1">العنوان</label>
                                                <input type="text" name="title" class="form-control rounded-3" value="<%= book.title %>">
                                            </div>
                                            <div class="col-12 col-md-2">
                                                <label class="small fw-bold mb-1">التصنيف</label>
                                                <input type="text" name="category" class="form-control rounded-3" value="<%= book.category %>">
                                            </div>
                                            <div class="col-12 col-md-2">
                                                <label class="small fw-bold mb-1">السعر</label>
                                                <input type="number" name="price" class="form-control rounded-3" value="<%= book.price %>">
                                            </div>
                                            <div class="col-12 col-md-2">
                                                <label class="small fw-bold mb-1">المؤلف</label>
                                                <select name="author" class="form-select rounded-3">
                                                    <option value="<%= book.author ? book.author._id : '' %>" selected>
                                                        <%= book.author ? (book.author.firstName + ' ' + book.author.lastName) : 'اختر مؤلفاً' %>
                                                    </option>
                                                    <option value="69b5d4088fb46f6c7f339288">دعاء الصافي</option>
                                                    <option value="69bb0f7e66fc3f0dd7544a83">حسان الحسين</option>
                                                    <option value="69b5ea0a74442feb59dd4c77">فاطمة عدي</option>
                                                    <option value="69b6f469601453f68dc827e3">نوال الكتاب</option>
                                                    <option value="69bb0f9a66fc3f0dd7544a85">جمال البني</option>
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-3">
                                                <label class="small fw-bold mb-1">تغيير الغلاف</label>
                                                <input type="file" name="cover" class="form-control rounded-3" accept="image/*">
                                            </div>

                                            <div class="col-12">
                                                <label class="small fw-bold mb-1">تفاصيل الكتاب</label>
                                                <textarea name="description" class="form-control rounded-3" rows="3"><%= book.description %></textarea>
                                            </div>
                                            <div class="col-12 mt-4 d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                                                <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-toggle="collapse" data-bs-target="#editRow<%= book._id %>">إلغاء</button>
                                                <button type="submit" class="btn btn-success px-4 rounded-pill fw-bold">حفظ التغييرات</button>
                                            </div>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-book-half fs-1 d-block mb-3 opacity-50"></i>
                                لا توجد نتائج تطابق بحثك.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <% if (pages > 1) { %>
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <% for(let i=1; i <= pages; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link rounded-circle mx-1" href="/admin/books?pageNumber=<%= i %>&search=<%= query.search || '' %>&category=<%= query.category || '' %>">
                            <%= i %>
                        </a>
                    </li>
                <% } %>
            </ul>
        </nav>
    <% } %>
</div>

<div class="modal fade" id="addBookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i> إضافة كتاب جديد للمكتبة</h5>
                <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form action="/admin/books/add" method="POST" enctype="multipart/form-data">
                    
                    <% if (query && query.errorC) { %>
                        <div class="alert alert-warning border-0 shadow-sm mb-4 rounded-3 py-2">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <%= query.errorC %>
                        </div>
                    <% } %>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold text-secondary">عنوان الكتاب</label>
                            <input type="text" name="title" class="form-control rounded-3 bg-light border-0" placeholder="مثلاً: تعلم Node.js من الصفر" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">السعر ($)</label>
                            <input type="number" name="price" class="form-control rounded-3 bg-light border-0" placeholder="0.00" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">التصنيف</label>
                            <input type="text" name="category" class="form-control rounded-3 bg-light border-0" placeholder="مثلاً: برمجة" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">المؤلف</label>
                            <select name="author" class="form-select rounded-3 bg-light border-0" required>
                                <option value="" selected disabled>اختر مؤلفاً...</option>
                                <option value="69b5d4088fb46f6c7f339288">دعاء الصافي</option>
                                <option value="69bb0f7e66fc3f0dd7544a83">حسان الحسين</option>
                                <option value="69b5ea0a74442feb59dd4c77">فاطمة عدي</option>
                                <option value="69b6f469601453f68dc827e3">نوال الكتاب</option>
                                <option value="69bb0f9a66fc3f0dd7544a85">جمال البني</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-secondary">غلاف الكتاب</label>
                            <input type="file" name="cover" class="form-control rounded-3 bg-light border-0" accept="image/*" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-secondary">وصف الكتاب (اختياري)</label>
                            <textarea name="description" class="form-control rounded-3 bg-light border-0" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold flex-grow-1 shadow-sm">حفظ الكتاب</button>
                        <button type="button" class="btn btn-light rounded-pill px-4 fw-bold border" data-bs-dismiss="modal">إلغاء</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        
        if (urlParams.has('errorC')) {
            var addBookModal = new bootstrap.Modal(document.getElementById('addBookModal'));
            addBookModal.show();
        }

        if (urlParams.has('success') || urlParams.has('errorU') || urlParams.has('errorC')) {
            setTimeout(() => {
                window.history.replaceState({}, document.title, window.location.pathname);
            }, 5000);
        }
    });
</script>

<%- include("../layout/footer.ejs") %>