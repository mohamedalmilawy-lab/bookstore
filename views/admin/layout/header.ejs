<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>لوحة التحكم - بيت الكتب</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">
<div class="d-flex min-vh-100">
    <div class="offcanvas-lg offcanvas-start bg-dark text-white shadow" tabindex="-1" id="adminSidebar" style="width: 260px;">
        <div class="offcanvas-header d-lg-none border-bottom border-secondary">
            <h5 class="offcanvas-title fw-bold text-white">لوحة الإدارة</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar"></button>
        </div>

        <div class="p-2 vh-100 position-sticky top-0 overflow-y-auto">
            <div class="text-center mb-4 mt-3">
                <span class="fw-bold fs-3 px-2 text-white"><i class="fas fa-book-reader text-info me-2"></i></span>
                <h5 class="fw-bold fs-4 m-0">بيت الكتب</h5>
                <p class="small text-secondary mb-0">لوحة التحكم</p>
            </div>

            <ul class="nav flex-column gap-2">
                <li class="nav-item">
                    <a href="/admin/dashboard" class="nav-link text-white rounded-3 py-3 <%= typeof path !== 'undefined' && path === '/admin/dashboard' ? 'bg-primary active shadow' : 'hover-bg-secondary' %>">
                        <i class="bi bi-grid-1x2-fill me-2 ps-2"></i> الإحصائيات
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin/users" class="nav-link text-white rounded-3 py-3 <%= typeof path !== 'undefined' && path === '/admin/users' ? 'bg-primary active shadow' : '' %>">
                        <i class="bi bi-people-fill me-2 ps-2"></i> المستخدمين
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin/books" class="nav-link text-white rounded-3 px-3 py-3 <%= typeof path !== 'undefined' && path === '/admin/books' ? 'bg-primary active shadow' : '' %>">
                        <i class="bi bi-book-half me-2 ps-2"></i> الكتب
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin/authors" class="nav-link text-white rounded-3 px-3 py-3 <%= typeof path !== 'undefined' && path === '/admin/authors' ? 'bg-primary active shadow' : '' %>">
                        <i class="bi bi-person-lines-fill me-2 ps-2"></i> المؤلفين
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/admin/orders" class="nav-link text-white rounded-3 px-3 py-3 <%= typeof path !== 'undefined' && path === '/admin/orders' ? 'bg-primary active shadow' : '' %>">
                        <i class="bi bi-box-fill me-2 ps-2"></i> الطلبات
                    </a>
                </li>
                
                <li class="nav-item mt-">
                    <hr class="text-secondary">
                    <a href="/" class="btn btn-outline-light w-200 rounded-pill py-2 border-opacity-25">
                        <i class="bi bi-house-door-fill me-1"></i> العودة للموقع
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <div class="flex-grow-1 overflow-hidden">
        
        <header class="navbar navbar-dark bg-dark d-lg-none px-3 shadow-sm py-2">
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <span class="navbar-brand fs-6 fw-bold">بيت الكتب - لوحة التحكم</span>
        </header>

        <main class="p-3 p-md-4">