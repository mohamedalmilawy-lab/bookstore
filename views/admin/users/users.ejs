<%- include("../layout/header.ejs") %>

<div class="container-fluid mt-3" dir="rtl">
    <% if (typeof query !== 'undefined' && query.success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= query.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query.errorU) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>خطأ في التعديل:</strong> <%= query.errorU %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <h3 class="fw-bold text-dark m-0 text-center text-md-start">
            <i class="fas fa-users text-primary me-2"></i> إدارة الأعضاء
        </h3>
        <span class="badge bg-primary bg-gradient rounded-pill px-3 py-2 fs-6 shadow-sm w-100 w-md-auto text-center" style="max-width: fit-content;">
            إجمالي الأعضاء: <%= users.length %>
        </span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-end text-nowrap">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="py-3 px-4 border-0">المستخدم</th>
                        <th class="py-3 border-0">البريد الإلكتروني</th>
                        <th class="py-3 border-0 text-center">الصلاحية</th>
                        <th class="py-3 border-0 text-center">العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users.length > 0) { %>
                        <% users.forEach(user => { %>
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm ms-2 flex-shrink-0" style="width: 45px; height: 45px; font-size: 1.2rem; font-weight: bold;">
                                            <%= user.username.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark"><%= user.username %></div>
                                            <div class="small text-muted">ID: #<%= user._id.toString().slice(-6).toUpperCase() %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted"><%= user.email %></td>
                                <td class="text-center">
                                    <span class="badge <%= user.isAdmin ? 'bg-danger-subtle text-danger border-danger' : 'bg-success-subtle text-success border-success' %> border rounded-pill px-3">
                                        <%= user.isAdmin ? 'مدير النظام' : 'مستخدم عادي' %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" 
                                                type="button" 
                                                data-bs-toggle="collapse" 
                                                data-bs-target="#editForm<%= user._id %>">
                                            <i class="bi bi-pencil-square"></i> <span class="d-none d-sm-inline ms-1">تعديل</span>
                                        </button>

                                        <form action="/admin/users/delete/<%= user._id %>" method="POST" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا المستخدم؟');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">
                                                <i class="bi bi-trash3"></i> <span class="d-none d-sm-inline ms-1">حذف</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <tr class="collapse bg-light" id="editForm<%= user._id %>">
                                <td colspan="4" class="p-0 border-bottom shadow-inner">
                                    <div class="p-3 p-md-4">
                                        <div class="card card-body border-0 bg-white shadow-sm rounded-4">
                                            <h6 class="fw-bold mb-3 text-wrap"><i class="fas fa-user-edit text-primary me-2"></i> تعديل بيانات: <%= user.username %></h6>
                                            
                                            <form action="/admin/users/update/<%= user._id %>" method="POST">
                                                <div class="row g-3">
                                                    <div class="col-12 col-md-4">
                                                        <label class="form-label small fw-bold">اسم المستخدم</label>
                                                        <input type="text" name="username" class="form-control rounded-3" value="<%= user.username %>">
                                                    </div>
                                                    <div class="col-12 col-md-4">
                                                        <label class="form-label small fw-bold">البريد الإلكتروني</label>
                                                        <input type="email" name="email" class="form-control rounded-3" value="<%= user.email %>">
                                                    </div>
                                                    <div class="col-12 col-md-4">
                                                        <label class="form-label small fw-bold">الصلاحية</label>
                                                        <select name="isAdmin" class="form-select rounded-3">
                                                            <option value="false" <%= !user.isAdmin ? 'selected' : '' %>>مستخدم عادي</option>
                                                            <option value="true" <%= user.isAdmin ? 'selected' : '' %>>مدير النظام (Admin)</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12 mt-4 d-flex flex-column flex-md-row justify-content-md-end gap-2">
                                                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-toggle="collapse" data-bs-target="#editForm<%= user._id %>">إلغاء</button>
                                                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">حفظ التغييرات</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-user-slash fa-3x mb-3 opacity-50"></i>
                                <h5>لا يوجد مستخدمين مسجلين حالياً</h5>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // هذا الكود يمسح "success" و "errorU" من الرابط بعد 4 ثوانٍ من ظهور الصفحة
    document.addEventListener("DOMContentLoaded", function() {
        const url = new URL(window.location);
        if (url.searchParams.has('success') || url.searchParams.has('errorU')) {
            setTimeout(() => {
                url.searchParams.delete('success');
                url.searchParams.delete('errorU');
                window.history.replaceState({}, document.title, url.pathname + url.search);
                
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 4000);
        }
    });
</script>

<%- include("../layout/footer.ejs") %>