<%- include("layout/header.ejs") %>
    <h2 class="fw-bold mb-4 border-bottom pb-3">الإحصائيات العامة</h2>

    <div class="row g-4 text-center">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white rounded-4">
                <div class="card-body py-4">
                    <i class="bi bi-book-half fs-1 mb-2"></i>
                    <h5 class="card-title opacity-75">إجمالي الكتب</h5>
                    <h2 class="fw-bold"> <%= booksCount %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white rounded-4">
                <div class="card-body py-4">                    
                    <i class="bi bi-person-lines-fill fs-1 mb-2"></i>
                    <h5 class="card-title opacity-75">المؤلفين</h5>
                    <h2 class="fw-bold"> <%= authorsCount %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-dark text-white rounded-4">
                <div class="card-body py-4">
                    <i class="bi bi-people-fill fs-1 mb-2"></i>
                    <h5 class="card-title opacity-75">المستخدمين</h5>
                    <h2 class="fw-bold"> <%= usersCount %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-secondary text-white rounded-4">
                <div class="card-body py-4">
                    <i class="bi bi-box-fill fs-1 mb-2"></i>
                    <h5 class="card-title opacity-75">الطلبات</h5>
                    <h2 class="fw-bold"> <%= ordersCount %></h2>
                </div>
            </div>
        </div>

    </div>
<%- include("layout/footer.ejs") %>
