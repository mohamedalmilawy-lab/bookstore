<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container py-5" dir="rtl">
    <div class="row g-5 align-items-center">
        <div class="col-md-5 text-center">
            <img src="../../images/<%= book.cover %>" class="img-fluid rounded-4 shadow-lg" alt="<%= book.title %>" style="max-height: 500px;">
        </div>

        <div class="col-md-7">
            <h1 class="fw-bold display-5 mb-3"><%= book.title %></h1>
            <h4 class="text-muted mb-4">الكاتب: <span class="text-dark"><%= book.author.firstName %> <%= book.author.lastName %></span></h4>
            
            <div class="d-flex align-items-center mb-4">
                <span class="h2 fw-bold text-primary mb-0">$<%= book.price %></span>
                <span class="badge bg-success-subtle text-success ms-3 px-3 py-2 rounded-pill">متوفر في المخزن</span>
            </div>

            <p class="text-secondary mb-5 fs-5 lead"><%= book.description %> </p>

            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <form action="/cart/add/<%= book._id %>" method="POST" class="d-flex flex-wrap align-items-end gap-2 m-0">
                    <div>
                        <label class="fw-bold small mb-1 d-block">الكمية:</label>
                        <input type="number" name="quantity" value="1" min="1" class="form-control text-center rounded-3 shadow-none" style="width: 80px;">
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm px-4">
                            <i class="fas fa-shopping-basket ms-2"></i> أضف إلى السلة
                        </button>
                    </div>
                </form>
                <form action="/favorites/<%= book._id %>" method="POST" class="m-0">
                    <button id="fav-btn" type="submit" class="btn btn-outline-danger btn-lg rounded-pill px-3 shadow-sm d-flex align-items-center justify-content-center" style="height: 48px;" onclick="toggleFavorite('<%= book._id %>')">
                        <i id="fav-icon" class="bi <%= user && user.favorites.includes(book._id) ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                    </button>
                </form>
            </div>
            
            <hr class="my-5">
            <div class="small text-muted">
                <span><i class="fas fa-truck ms-2"></i> توصيل سريع خلال 24 ساعة</span>
            </div>
        </div>
    </div>
</div>

<%- include("../layout/footer") %>