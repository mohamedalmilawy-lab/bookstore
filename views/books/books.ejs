<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container mt-5" dir="rtl">
    <div class="row">

        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 position-sticky" style="top: 20px;">
                <h5 class="fw-bold mb-3 border-bottom pb-2">🔍 تصفية النتائج</h5>

                <form action="/books" method="GET">
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">البحث باسم الكتاب</label>
                        <div class="position-relative">
                            <input type="text" name="search" value="<%= query.search || '' %>" class="form-control rounded-pill border-2 px-3 shadow-none" placeholder="أدخل اسم الكتاب...">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">التصنيف</label>
                        <select name="category" class="form-select rounded-pill shadow-none border-2">
                            <option value="">كل التصنيفات</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">المؤلف</label>
                        <select name="author" class="form-select rounded-pill shadow-none border-2">
                            <option value="">كل المؤلفين</option>
                            <% authors.forEach(author => { %>
                                <option value="<%= author._id %>" <%= query.author === author._id.toString() ? 'selected' : '' %>>
                                    <%= author.firstName %> <%= author.lastName %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">السعر (من - إلى)</label>
                        <div class="d-flex gap-2">
                            <input type="number" name="minPrice" value="<%= query.minPrice || '' %>" class="form-control rounded-pill border-2 px-3 shadow-none" placeholder="أقل">
                            <input type="number" name="maxPrice" value="<%= query.maxPrice || '' %>" class="form-control rounded-pill border-2 px-3 shadow-none" placeholder="أكثر">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold mt-2 shadow-sm">
                        تطبيق الفلاتر
                    </button>

                    <a href="/books" class="btn btn-link w-100 btn-sm text-muted text-decoration-none mt-2">إعادة ضبط</a>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">📚 قائمة الكتب</h2>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 shadow-sm">
                    <%= books.length %> كتب في الصفحة
                </span>
            </div>

            <div class="row g-4">
                <% if (books.length===0) { %>
                    <div class="col-12 text-center py-5">
                        <div class="display-1 text-muted mb-3 opacity-25">🔍</div>
                        <p class="text-muted mt-3 fs-5">لا توجد كتب تطابق بحثك حالياً.</p>
                        <a href="/books" class="btn btn-outline-primary rounded-pill mt-2">عرض كل الكتب</a>
                    </div>
                <% } %>

                <% books.forEach(book=> { %>
                    <div class="col-md-6 col-xl-4 mb-3 feature-card">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover transition-all">
                            <div class="position-relative">
                                <img src="/images/<%= book.cover %>" class="card-img-top" style="height:280px; object-fit:cover;" alt="<%= book.title %>">
                                <span class="position-absolute top-0 start-0 m-3 badge bg-primary rounded-pill px-3 shadow">
                                    <%= book.category %>
                                </span>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold text-dark mb-1 text-truncate pb-1 border-bottom">
                                    <%= book.title %>
                                </h5>
                                <p class="small text-muted mb-3">
                                    بواسط: <span class="text-dark fw-semibold">
                                        <%= book.author.firstName %> <%= book.author.lastName %>
                                    </span>
                                </p>

                                <span class="fs-5 fw-bold text-success">$<%= book.price %></span>
                                <div class="mt-auto d-flex justify-content-between align-items-center mt-3">
                                    <form action="/cart/add/<%= book._id %>" method="POST">
                                        <button type="submit" class="btn btn-outline-primary rounded-pill position-relative ms-2">
                                            <i class="bi bi-cart3"></i>
                                        </button>
                                    </form>
                                    <!-- ايقونة المفضلة -->
                                    <form action="/favorites/<%= book._id %>" method="POST">
                                        <button id="fav-btn" class="btn btn-outline-danger btn-lg rounded-pill py-1 px-2 shadow-sm" 
                                                onclick="toggleFavorite('<%= book._id %>')">
                                            <i id="fav-icon" class="bi <%= user && user.favorites.includes(book._id) ? 'bi bi-heart-fill' : 'bi bi-heart' %>"></i>
                                        </button>
                                    </form>
                                    <a href="/books/<%= book._id %>" class="btn btn-dark rounded-pill px-4 btn-sm shadow-sm fw-bold">
                                        التفاصيل
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <% if (pages > 1) { %>
                <nav class="mt-5 d-flex justify-content-center">
                    <ul class="pagination shadow-sm">
                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <% let prevQuery=new URLSearchParams(query); prevQuery.set('pageNumber', currentPage - 1); %>
                            <a class="page-link rounded-start-pill px-3" href="/books?<%= prevQuery.toString() %>">السابق</a>
                        </li>

                        <% for(let i=1; i <=pages; i++) { %>
                            <% let pageQuery=new URLSearchParams(query); pageQuery.set('pageNumber', i); %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link px-3" href="/books?<%= pageQuery.toString() %>"><%= i %></a>
                            </li>
                        <% } %>

                        <li class="page-item <%= currentPage === pages ? 'disabled' : '' %>">
                            <% let nextQuery=new URLSearchParams(query); nextQuery.set('pageNumber', currentPage + 1); %>
                            <a class="page-link rounded-end-pill px-3" href="/books?<%= nextQuery.toString() %>">التالي</a>
                        </li>
                    </ul>
                </nav>
            <% } %>
        </div>
    </div>
</div>

<%- include("../layout/footer") %>