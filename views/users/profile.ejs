<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container py-5 mt-5" dir="rtl">
    <% if (errorMessage) { %>
        <div
            class="alert <% if (errorMessage.includes('نجاح')) { %>alert-success<% } else { %>alert-danger<% } %> border-0 shadow-sm rounded-3 mb-4 text-center">
            <%= errorMessage %>
        </div>
    <% } %>

    <div class="row g-4 d-flex align-items-stretch">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm"
                            style="width: 80px; height: 80px; font-size: 2rem;">
                            <%= user.username.charAt(0).toUpperCase() %>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1">
                        <%= user.username %>
                    </h3>
                    <p class="text-muted small mb-3 text-lowercase">
                        <%= user.email %>
                    </p>
                    <hr class="opacity-75">
                    <div class="d-grid gap-2 mt-auto">
                        <a href="/auth/logout"
                            class="btn btn-outline-danger rounded-pill fw-bold btn-animated">
                            <i class="fas fa-sign-out-alt ms-1"></i> تسجيل الخروج
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <ul class="nav nav-tabs border-bottom">
                        <li class="nav-item">
                            <a href="/users/orders/<%= user._id || user.id %>"
                                class="nav-link fw-bold border-0 pb-3 text-secondary">
                                <i class="fas fa-shopping-bag ms-2"></i> طلباتي السابقة
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/users/profile/<%= user._id || user.id %>"
                                class="nav-link active fw-bold border-0 pb-3">
                                <i class="fas fa-cog ms-2"></i> إعدادات الحساب
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <form action="/users/profile/<%= user._id || user.id %>" method="POST">
                                <label class="form-label small fw-bold text-secondary">اسم
                                    المستخدم</label>
                                <input type="text" class="form-control bg-light border-0 rounded-3 py-2"
                                    value="<%= user.username %>" name="username">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">البريد
                                الإلكتروني</label>
                            <input type="email"
                                class="form-control bg-light border-0 rounded-3 py-2 text-lowercase"
                                value="<%= user.email %>" name="email">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-secondary">كلمة مرور
                                جديدة</label>
                            <input type="password" class="form-control bg-light border-0 rounded-3 py-2"
                                name="password" placeholder="اتركها فارغة للإبقاء على الحالية">
                        </div>
                        <div class="col-12 text-end mt-4">
                            <button type="submit"
                                class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                                حفظ التغييرات
                            </button>
                            </form>

                            <form action="/users/delete/<%= user._id %>" method="POST"
                                class="d-inline-block"
                                onsubmit="return confirm('حذف المستخدم لن تستطيع التراجع عنها؟');">
                                <button type="submit"
                                    class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 ms-2 fw-bold">
                                    <i class="fas fa-trash-alt me-1"></i> حذف الحساب
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../layout/footer") %>