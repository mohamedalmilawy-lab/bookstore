<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container py-5 mt-5" dir="rtl">
    <div class="row g-4 d-flex align-items-stretch">
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px; font-size: 2rem;">
                            <%= user.username.charAt(0).toUpperCase() %>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1"><%= user.username %></h3>
                    <p class="text-muted small mb-3 text-lowercase"><%= user.email %></p>
                    <hr class="opacity-75">
                    <div class="d-grid gap-2 mt-auto">
                        <a href="/auth/logout" class="btn btn-outline-danger rounded-pill fw-bold btn-animated">
                            <i class="fas fa-sign-out-alt ms-1"></i> تسجيل الخروج
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <ul class="nav nav-tabs border-bottom">
                        <li class="nav-item">
                            <a href="/users/orders/<%= user._id || user.id %>" class="nav-link active fw-bold border-0 pb-3">
                                <i class="fas fa-shopping-bag ms-2"></i> طلباتي السابقة
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/users/profile/<%= user._id || user.id %>" class="nav-link fw-bold border-0 pb-3 text-secondary">
                                <i class="fas fa-cog ms-2"></i> إعدادات الحساب
                            </a>
                        </li>
                    </ul>
                </div>
                
                <div class="card-body p-4">
                    <% if (orders && orders.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle border-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="border-0 rounded-start">رقم الطلب</th>
                                        <th class="border-0">التاريخ</th>
                                        <th class="border-0">الكتب</th>
                                        <th class="border-0 text-center">الإجمالي</th>
                                        <th class="border-0 rounded-end text-center">الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% orders.forEach(order => { %>
                                        <tr>
                                            <td class="small text-muted fw-bold">
                                                #<%= order._id.toString().slice(-6).toUpperCase() %>
                                            </td>
                                            <td class="small">
                                                <%= new Date(order.createdAt).toLocaleDateString('ar-EG') %>
                                            </td>
                                            <td>
                                                <ul class="list-unstyled mb-0 small">
                                                    <% order.books.forEach(item => { %>
                                                        <li>
                                                            <i class="bi bi-book-half text-primary me-1"></i>
                                                            <%= item.bookId ? item.bookId.title : 'كتاب غير متوفر' %>
                                                            <span class="badge bg-light text-dark shadow-sm px-2">x <%= item.quantity %></span>
                                                        </li>
                                                    <% }) %>
                                                </ul>
                                            </td>
                                            <td class="text-center fw-bold text-success">
                                                <%= order.totalPrice %>$
                                            </td>
                                            <td class="text-center">
                                                <% if(order.status === "قيد المعالجة") { %>
                                                    <span class="badge rounded-pill bg-warning-subtle text-warning px-3 py-2 border border-warning">قيد المعالجة</span>
                                                <% } else if(order.status === "تم التسليم") { %>
                                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2 border border-success">تم التسليم</span>
                                                <% } else { %>
                                                    <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2 border border-danger">ملغي</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <div class="display-1 text-light mb-3">📦</div>
                            <h5 class="text-muted">لا يوجد طلبات سابقة حتى الآن</h5>
                            <a href="/books" class="btn btn-primary rounded-pill mt-3 px-4 fw-bold shadow-sm">ابدأ التسوق الآن</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../layout/footer") %>