<%- include("layout/header") %>
<%- include("layout/navbar") %>


<div class="container mt-5" dir="rtl">
    <% if (query && query.success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= query.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>

<div class="container my-5 py-5" dir="rtl">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6 text-center text-md-start">
            <h2 class="fw-bold mb-0">قائمة مفضلاتي</h2>
        </div>
        <div class="col-md-6 text-center text-md-end">
            <a href="/books" class="btn btn-outline-primary rounded-pill">
                <i class="bi bi-plus-lg ms-1"></i> استكشف المزيد من الكتب
            </a>
        </div>
    </div>

    <hr class="mb-5 opacity-25">

    <div class="row g-4" id="favorites-grid">
        <% if (user.favorites && user.favorites.length > 0) { %>
            <% user.favorites.forEach(book => { %>
                <div class="col-md-6 col-lg-4 col-xl-3" id="book-card-<%= book._id %>">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative card-hover">
                        <form action="/favorites/remove/<%= book._id %>" method="POST">
                            <button class="btn btn-sm btn-outline-danger rounded-circle position-absolute top-0 end-0 m-2" >
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                        <div class="text-center bg-light p-3">
                            <img src="/images/<%= book.cover %>" 
                                 class="rounded-3 shadow-sm" 
                                 alt="<%= book.title %>"
                                 style="height: 200px; width: 100%; object-fit: contain;">
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h6 class="fw-bold text-dark text-truncate mb-1"><%= book.title %></h6>
                            <p class="text-muted small mb-3">
                                تأليف: <%= book.author ? book.author.firstName + ' ' + book.author.lastName : 'غير معروف' %>
                            </p>
                            
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-primary fs-5">$<%= book.price %></span>
                                <div class="btn-group gap-2">
                                    <a href="/books/<%= book._id %>" class="btn btn-sm btn-dark rounded-pill px-3 ms-1">التفاصيل</a>
                                    <form action="/cart/add/<%= book._id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5" id="empty-state">
                <div class="mb-4">
                    <i class="bi bi-heartbreak display-1 text-muted opacity-25"></i>
                </div>
                <h4 class="text-muted">قائمة مفضلاتك فارغة حالياً</h4>
                <p class="text-secondary mb-4">ابدأ بإضافة الكتب التي تحبها لتجدها هنا دائماً.</p>
                <a href="/books" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">تصفح الكتب الآن</a>
            </div>
        <% } %>
    </div>
</div>
<%- include("layout/footer") %>
