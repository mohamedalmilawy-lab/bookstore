<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;" dir="rtl">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            
            <div class="display-4 text-primary mb-3">🔐</div>
            
            <h3 class="fw-bold mb-2">تعيين كلمة مرور جديدة</h3>
            
            <p class="text-muted small mb-4">
                أدخل كلمة المرور الجديدة لحساب: <br>
                <strong class="text-dark fs-6" dir="ltr"><%= email %></strong>
            </p>

            <% if (locals.errorMessage) { %>
                <div class="alert alert-danger border-0 rounded-3 small py-2 mb-3">
                    <i class="fas fa-exclamation-circle ms-2"></i> <%= errorMessage %>
                </div>
            <% } %>

            <form action="" method="POST">
                
                <div class="form-floating mb-3">
                    <input type="password" class="form-control rounded-3 border-light bg-light shadow-none" id="password" name="password" placeholder="كلمة المرور الجديدة" required minlength="6">
                    <label for="password" class="text-muted">كلمة المرور الجديدة</label>
                </div>

                <div class="form-floating mb-4">
                    <input type="password" class="form-control rounded-3 border-light bg-light shadow-none" id="confirmPassword" name="confirmPassword" placeholder="تأكيد كلمة المرور" required minlength="6">
                    <label for="confirmPassword" class="text-muted">تأكيد كلمة المرور</label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm btn-animated mb-2">
                    حفظ كلمة المرور
                </button>
            </form>
            
        </div>
    </div>
</div>

<%- include("../layout/footer") %>