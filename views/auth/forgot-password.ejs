<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;" dir="rtl">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            
            <div class="display-4 text-primary mb-3">🔑</div>
            
            <h3 class="fw-bold mb-2">استعادة كلمة المرور</h3>
            <p class="text-muted small mb-4">أدخل بريدك الإلكتروني وسنرسل لك رابطاً لإعادة تعيين كلمة المرور الخاصة بك.</p>

            <% if (errorMessage) { %>
                <div class="alert alert-danger border-0 rounded-3 small py-2 mb-3">
                    <i class="fas fa-exclamation-circle ms-2"></i> <%= errorMessage %>
                </div>
            <% } %>

            <form method="POST" action="/auth/forgot-password">
                <div class="form-floating mb-3">
                    <input type="email" name="email" class="form-control rounded-3 border-light bg-light shadow-none" id="floatingInput" placeholder="name@example.com" required>
                    <label for="floatingInput" class="text-muted">البريد الإلكتروني</label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm transition-all mb-3">
                    إرسال الرابط
                </button>
            </form>

            <div class="mt-3">
                <a href="/auth/login" class="text-decoration-none small text-primary fw-bold">
                    <i class="fas fa-arrow-right ms-1"></i> العودة لتسجيل الدخول
                </a>
            </div>
        </div>
    </div>
</div>

<%- include("../layout/footer") %>