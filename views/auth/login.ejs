<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container d-flex align-items-center justify-content-center pt-5">
    
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            
            <div class="card-header bg-primary text-white text-center py-4 border-0">
                <h3 class="fw-bold mb-1">مرحباً بك مجدداً 👋</h3>
                <p class="small text-white-50 mb-0">سجل دخولك للوصول إلى مكتبتك الخاصة</p>
            </div>

            <div class="card-body p-4 p-md-5" dir="rtl">
                
                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                        <%= errorMessage %>
                    </div>
                <% } %>

                <form action="/auth/login" method="POST">
                    
                    <div class="mb-4">
                        <label for="email" class="form-label fw-bold text-secondary small">البريد الإلكتروني</label>
                        <input type="email" class="form-control form-control-lg bg-light border-0 shadow-sm" 
                               id="email" name="email" placeholder="أدخل بريدك الإلكتروني" required>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <label for="password" class="form-label fw-bold text-secondary small mb-0">كلمة المرور</label>
                        </div>
                        <input type="password" class="form-control form-control-lg bg-light border-0 shadow-sm" dir="ltr" 
                        id="password" name="password" placeholder="أدخل كلمة المرور" required>
                    </div>
                    <a href="/auth/forgot-password" class="text-decoration-none small fw-bold">نسيت كلمة المرور؟</a>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                            تسجيل الدخول
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4 pt-2">
                    <p class="text-muted small mb-0">
                        ليس لديك حساب؟ 
                        <a href="/auth/register" class="text-primary fw-bold text-decoration-none">إنشاء حساب جديد</a>
                    </p>
                </div>
            </div>
            
            <div class="card-footer bg-light border-0 py-3 text-center">
                <span class="text-muted small">© بيت الكتب - جميع الحقوق محفوظة</span>
            </div>
        </div>
    </div>
</div>

<%- include("../layout/footer") %>