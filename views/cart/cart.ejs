<%- include("../layout/header") %>
<%- include("../layout/navbar") %>

<div class="container mt-5" dir="rtl">
    <% if (query && query.success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= query.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>

<div class="container py-5 mt-5" dir="rtl">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            <i class="fas fa-shopping-cart text-primary ms-2"></i> سلة المشتريات
        </h2>

        <span class="badge bg-soft-primary text-primary border rounded-pill px-3 ms-auto">
            <%= cart.reduce((sum, item) => sum + item.quantity, 0) %> كتب
        </span>
    </div>

    <% if (cart.length > 0) { %>
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="p-3">الكتاب</th>
                                    <th class="p-3 text-center">الكمية</th>
                                    <th class="p-3 text-center">السعر</th>
                                    <th class="p-3 text-center">الإجراء</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% cart.filter(item => item.bookId).forEach(item => { %>
                                    <tr>
                               
                                        <td class="p-3">
                                            <div class="d-flex align-items-center">
                                                <a href="/books/<%= item.bookId._id %>">
                                                    <img src="/images/<%= item.bookId.cover || 'default.jpg' %>" 
                                                        class="rounded-3 ms-3"
                                                        style="width: 60px; height: 80px; object-fit: cover;">
                                                </a>
                                                <div>
                                                    <a href="/books/<%= item.bookId._id %>" class="fw-bold text-dark text-decoration-none">
                                                        <%= item.bookId.title %>
                                                    </a>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-center">                     
                                            <div class="d-flex justify-content-center align-items-center gap-2">

                                                <form action="/cart/removeOne/<%= item.bookId._id %>" method="POST">
                                                    <button class="btn btn-sm btn-outline-danger rounded-circle px-2">
                                                        -
                                                    </button>
                                                </form>

                               
                                                <span class="fw-bold px-2">
                                                    <%= item.quantity %>
                                                </span>

                                                <form action="/cart/add/<%= item.bookId._id %>" method="POST">
                                                    <button class="btn btn-sm btn-outline-success rounded-circle px-2">
                                                        +
                                                    </button>
                                                </form>

                                            </div>

                                        </td>

                                        <td class="text-center fw-bold text-primary">
                                            <%= (item.bookId.price * item.quantity).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> $
                                        </td>

                                   
                                        <td class="text-center">
                                            <form action="/cart/remove/<%= item.bookId._id %>" method="POST">
                                                <button class="btn btn-sm btn-outline-danger rounded-circle">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>

                                    </tr>
                                <% }) %>
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4">

                    <h5 class="fw-bold mb-4">ملخص الطلب</h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span>الإجمالي</span>
                        <span class="fw-bold">
                            <%= totalPrice.toLocaleString('en-US', { minimumFractionDigits: 2 }) %> $
                        </span>
                    </div>
                    <hr>
                    <a href="/cart/checkout" class="btn btn-primary w-100 rounded-pill py-3 fw-bold">
                        إتمام الشراء
                    </a>
                </div>
            </div>
        </div>
    <% } else { %>

        <div class="text-center py-5">
            <h3>السلة فارغة</h3>
            <% } %>
            <a href="/books" class="btn btn-primary mt-3 mx-3">تصفح الكتب</a>
            <a href="/users/orders/<%= user._id || user.id %>" class="btn btn-primary mt-3 ">طلباتي السابقة</a>
        </div>
</div>

<%- include("../layout/footer") %>